# Copy to secrets.properties (git-ignored). Optional: without it release builds ship with ads OFF.
# Create these in the AdMob console (app + banner ad unit). Debug builds always use Google's test IDs regardless.
admob.appId=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
admob.bannerUnitId=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
# Sell VCardly Pro (scan limit for free users, PDF/Excel exports for Pro). Only set this once the Pro products exist in
# Play Console; without it everything is free and no upgrade prompts are shown.
# pro.forSale=true
