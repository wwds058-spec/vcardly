<?xml version="1.0" encoding="utf-8"?>
<!-- Contacts are personal data: exclude everything from cloud backup and device transfer.
     Users back up explicitly through VCardly's own versioned backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
