/* Privacy */
"privacy.title" = "Privacy";
"privacy.intro" = "VCardly is built to keep your contacts yours. Here is exactly what it does with your data.";
"privacy.stays.title" = "Your data stays on this device";
"privacy.stays.body" = "Contacts, card photos, notes, tags, follow-ups and settings are stored in the app's private storage on this iPhone. Card photos are excluded from iCloud backup.";
"privacy.no_account.title" = "No account";
"privacy.no_account.body" = "There is no sign-in and no VCardly server. Your contacts are never uploaded. The iPhone app shows no ads.";
"privacy.permissions.title" = "Permissions and why";
"privacy.permissions.body" = "Camera: only while you scan a card; photos stay on the device. Notifications: to show your follow-up reminders; they show the task type and contact name, never your notes. Face ID: only to unlock the app; VCardly never sees your biometric data. Contacts: VCardly never asks for your address book; when you import, you pick people in Apple's picker and only they are handed over.";
"privacy.ocr.title" = "Reading business cards";
"privacy.ocr.body" = "Text on a card is recognised on the device by Apple's Vision framework. The recognised text is never stored or logged: you review it, and only what you save is kept.";
"privacy.sharing.title" = "Sharing";
"privacy.sharing.body" = "Nothing is shared unless you choose to. When you share a QR code or contact file you pick which details go in, and your private notes are never included. Copied text stays on this iPhone and expires after two minutes.";
"privacy.lock.title" = "App lock";
"privacy.lock.body" = "App lock asks for Face ID, Touch ID or your passcode, and locks again after the time you choose. It controls access to the app; iOS data protection encrypts the stored data.";
"privacy.backup.title" = "Backups";
"privacy.backup.body" = "A backup file contains all your contacts. Protect it with a password (recommended): it is then encrypted and cannot be opened without it. We cannot recover a forgotten password. Backups use the same format as VCardly for Android, so you can move your contacts between phones.";
"privacy.control.title" = "You are in control";
"privacy.control.body" = "You can edit or delete any contact at any time. Deleting the app removes all of its data from the iPhone.";

